local exact-requirements = <threading>multi <cxxstd>17
    <toolset>clang:<cxxflags>-ffp-contract=off
    <toolset>darwin:<cxxflags>-ffp-contract=off
    <toolset>gcc:<cxxflags>-ffp-contract=off
    <toolset>msvc:<cxxflags>/fp:strict ;

